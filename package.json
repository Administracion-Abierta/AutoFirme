{
  "name": "autofirme-web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": "24.x"
  },
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:tauri": "vite build --mode tauri",
    "preview": "vite preview",
    "test": "vitest run && node --test extension/tests/*.test.js && node --test scripts/check-extension.test.mjs && node --test scripts/release-workflow.test.mjs",
    "verify:zip": "node scripts/verify-batch-zip.mjs",
    "verify:real": "bash scripts/smoke-real.sh",
    "perf": "node --import ./scripts/ts-hook.mjs scripts/perf-budget.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.extension.json",
    "build:extension": "svelte-kit sync && node scripts/build-extension.mjs",
    "check:extension": "node scripts/check-extension.mjs",
    "test:extension:unit": "node --test extension/tests/*.test.js",
    "test:extension:browser": "node scripts/test-extension-browser.mjs",
    "test:extension:artifacts": "node --test scripts/check-extension.test.mjs",
    "package:extension": "python3 scripts/package-extension.py",
    "check:versions": "node scripts/check-versions.mjs",
    "demo:chromium": "playwright install chromium",
    "demo:registradores": "node demo/registradores.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.56.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.6.5",
    "bits-ui": "^2.19.5",
    "clsx": "^2.1.1",
    "jsdom": "^30.1.2",
    "mode-watcher": "^1.1.0",
    "playwright": "^1.64.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "fflate": "^0.8.3",
    "pdf-lib": "npm:@cantoo/pdf-lib@^2.11.1"
  }
}
