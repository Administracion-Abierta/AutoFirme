{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AutoFirme",
  "version": "0.1.2",
  "identifier": "es.autofirme.web",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build:tauri",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AutoFirme",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https: http:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "externalBin": ["binaries/autofirme-mcp"]
  }
}
