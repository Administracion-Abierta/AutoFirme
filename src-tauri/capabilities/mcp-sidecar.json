{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "mcp-sidecar",
  "description": "Lets the frontend spawn the bundled autofirme-mcp sidecar only (Refs #107). No other shell command is allowed.",
  "windows": ["main"],
  "permissions": [
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        { "name": "binaries/autofirme-mcp", "sidecar": true },
        { "name": "autofirme-mcp", "sidecar": true }
      ]
    },
    {
      "identifier": "shell:allow-kill"
    }
  ]
}
