{
  "name": "AutoFirma Web",
  "short_name": "AutoFirma",
  "description": "Firma electrónica en tu navegador / Electronic signature in your browser",
  "lang": "es",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "theme_color": "#008d80",
  "background_color": "#fbfaf7",
  "categories": ["utilities", "productivity"],
  "launch_handler": { "client_mode": "navigate-new" },
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Firmar / Sign",
      "short_name": "Firmar",
      "url": "/?entry=sign",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" }]
    }
  ],
  "share_target": {
    "action": "/?shared=1",
    "method": "POST",
    "enctype": "multipart/form-data",
    "title": "Firmar",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "documents", "accept": ["application/pdf", "application/xml", "text/xml", "*/*"] }]
    }
  },
  "file_handlers": [
    {
      "action": "/",
      "name": "sign",
      "launch_type": "single-client",
      "accept": {
        "application/pdf": [".pdf"],
        "application/xml": [".xml"],
        "text/xml": [".xml"]
      }
    }
  ]
}
