# AutoFirma MCP — remote (Streamable HTTP) server image.
# Build context is the REPO ROOT, because mcp/ imports the signing engine as source from src/:
#   podman build -f mcp/Containerfile -t registry.example/autofirme-mcp:0.1 .
# `mcp/` is a package of the root pnpm workspace, so the root manifests are what pin the lockfile.
FROM node:24-alpine AS build
WORKDIR /app
RUN corepack enable
# The manifests first, so a source-only change does not re-resolve the lockfile.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY mcp/package.json mcp/
RUN pnpm install --frozen-lockfile --filter autofirme-mcp
# The engine (`src/`) is compiled into the bundle; both trees must keep the repo's relative layout.
COPY src/ src/
COPY mcp/tsconfig.json mcp/
COPY mcp/src/ mcp/src/
RUN cd mcp && pnpm build

FROM node:24-alpine
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY mcp/package.json mcp/
RUN pnpm install --frozen-lockfile --prod --filter autofirme-mcp
COPY --from=build /app/mcp/dist mcp/dist
# Loopback by default: the deployment exposes it through the operator's Cloudflare Tunnel.
ENV AUTOFIRME_MCP_HOST=0.0.0.0 \
    AUTOFIRME_MCP_PORT=8790 \
    AUTOFIRME_MCP_WORKSPACE=/work
USER node
EXPOSE 8790
# Refuses to start without AUTOFIRME_MCP_TOKEN — see mcp/README.md.
CMD ["node", "mcp/dist/server-http.js"]
