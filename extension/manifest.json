{
  "manifest_version": 3,
  "name": "AutoFirme",
  "version": "0.2.0",
  "description": "AutoFirme: firma y verifica documentos localmente / Sign and verify documents locally.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Abrir AutoFirme / Open AutoFirme"
  },
  "options_page": "index.html",
  "icons": {
    "128": "icon-128.png",
    "192": "icon-192.png",
    "512": "icon-512.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
